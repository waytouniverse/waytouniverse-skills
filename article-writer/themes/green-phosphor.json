{
  "name": "绿磷",
  "description": "绿色科技深度长文风格 #07a35a，简洁标题无背景无边框，适合科技评论/深度分析文章",
  "colors": {
    "primary": "#333333",
    "accent": "#07a35a",
    "background": "#f5f5f5",
    "blockquote_bg": "rgba(7,163,90,0.05)",
    "code_bg": "#f8f9fa",
    "hr_color": "#07a35a",
    "footnote_bg": "#f5f5f5"
  },
  "styles": {
    "wrapper": {
      "background_color": "#f5f5f5",
      "padding": "16px"
    },
    "h1": {
      "font_size": "18px",
      "font_weight": "bold",
      "color": "#07a35a",
      "text_align": "left",
      "margin_top": "32px",
      "margin_bottom": "12px"
    },
    "h2": {
      "font_size": "18px",
      "font_weight": "bold",
      "color": "#07a35a",
      "line_height": "1.4",
      "margin_top": "32px",
      "margin_bottom": "12px",
      "padding": "0"
    },
    "h3": {
      "font_size": "16px",
      "font_weight": "bold",
      "color": "#1d1d1f",
      "line_height": "1.4",
      "padding": "0",
      "border_left": "3px solid #07a35a",
      "padding_left": "10px",
      "margin_top": "28px",
      "margin_bottom": "12px"
    },
    "p": {
      "font_size": "15px",
      "color": "#333333",
      "line_height": "1.8",
      "margin_top": "0",
      "margin_bottom": "19px",
      "letter_spacing": "0.5px",
      "text_align": "left"
    },
    "blockquote": {
      "border_left": "4px solid #07a35a",
      "background": "rgba(7,163,90,0.05)",
      "padding": "16px 19px",
      "margin_top": "24px",
      "margin_bottom": "24px",
      "border_radius": "0 8px 8px 0",
      "font_size": "15px",
      "color": "#333333",
      "line_height": "1.7"
    },
    "blockquote_p": {
      "font_size": "15px",
      "color": "#333333",
      "line_height": "1.7",
      "margin_bottom": "0"
    },
    "strong": {
      "font_weight": "600",
      "color": "#333333"
    },
    "em": {
      "font_style": "italic",
      "color": "#333333"
    },
    "a": {
      "color": "#07a35a",
      "text_decoration": "none"
    },
    "img": {
      "max_width": "100%",
      "border_radius": "8px",
      "display": "block",
      "box_shadow": "0 4px 15px rgba(0,0,0,0.08)"
    },
    "img_wrapper": {
      "background": "#f5f5f5",
      "border_radius": "10px",
      "padding": "4px",
      "margin_top": "10px",
      "margin_bottom": "10px"
    },
    "hr": {
      "margin_top": "40px",
      "margin_bottom": "40px",
      "height": "1px",
      "background": "#e0e0e0",
      "border": "none"
    },
    "code": {
      "background": "rgba(7,163,90,0.08)",
      "padding": "3px 6px",
      "border_radius": "4px",
      "font_size": "90%",
      "color": "#07a35a",
      "font_family": "'SFMono-Regular', Consolas, Menlo, monospace"
    },
    "code_block": {
      "background": "#f8f9fa",
      "border_radius": "8px",
      "margin_top": "24px",
      "margin_bottom": "24px",
      "overflow": "hidden",
      "box_shadow": "0 2px 8px rgba(0,0,0,0.06)"
    },
    "code_header": {
      "display": "flex",
      "align_items": "center",
      "height": "3px",
      "padding": "0",
      "background": "#07a35a"
    },
    "pre": {
      "background": "#f8f9fa",
      "color": "#1d1d1f",
      "padding": "19px",
      "border_radius": "0",
      "overflow_x": "auto",
      "margin_top": "0",
      "margin_bottom": "0",
      "font_size": "14px",
      "line_height": "1.5",
      "white_space": "pre-wrap",
      "word_wrap": "break-word",
      "word_break": "break-all"
    },
    "pre_code": {
      "background": "none",
      "padding": "0",
      "color": "#1d1d1f",
      "font_size": "14px",
      "font_family": "'SFMono-Regular', Consolas, Menlo, monospace"
    },
    "table": {
      "width": "100%",
      "border_collapse": "separate",
      "margin_top": "24px",
      "margin_bottom": "24px",
      "font_size": "15px",
      "border_spacing": "0",
      "border_radius": "8px",
      "overflow": "hidden",
      "box_shadow": "0 2px 8px rgba(0,0,0,0.05)"
    },
    "th": {
      "background": "rgba(7,163,90,0.06)",
      "padding": "12px 15px",
      "border_bottom": "1.5px solid rgba(7,163,90,0.15)",
      "text_align": "left",
      "font_weight": "600",
      "color": "#1d1d1f"
    },
    "td": {
      "padding": "10px 15px",
      "border_bottom": "1px solid rgba(0,0,0,0.06)",
      "color": "#333333"
    },
    "list_item_bullet": {
      "color": "#07a35a",
      "margin_right": "8px",
      "font_weight": "bold"
    },
    "ol_item_bullet": {
      "display": "inline-flex",
      "align_items": "center",
      "justify_content": "center",
      "width": "22px",
      "height": "22px",
      "min_width": "22px",
      "background": "rgba(7,163,90,0.1)",
      "color": "#07a35a",
      "border_radius": "50%",
      "font_size": "13px",
      "font_weight": "bold",
      "margin_right": "10px",
      "margin_top": "4px"
    },
    "list_item_text": {
      "font_size": "15px",
      "color": "#333333",
      "line_height": "1.7",
      "letter_spacing": "0.5px"
    },
    "list_wrapper": {
      "margin_top": "19px",
      "margin_bottom": "19px"
    },
    "list_item_row": {
      "display": "flex",
      "margin_bottom": "6px",
      "align_items": "flex-start"
    },
    "footnote_section": {
      "margin_top": "32px",
      "padding_top": "16px",
      "border_top": "1px dashed rgba(7,163,90,0.2)"
    },
    "footnote_title": {
      "font_size": "14px",
      "font_weight": "bold",
      "color": "#999999",
      "margin_bottom": "12px"
    },
    "footnote_item": {
      "font_size": "12px",
      "color": "#999999",
      "margin_bottom": "6px",
      "line_height": "1.6",
      "word_break": "break-all"
    },
    "footnote_sup": {
      "font_size": "12px",
      "color": "#07a35a",
      "vertical_align": "super",
      "margin_left": "2px"
    },
    "callout": {
      "background": "rgba(7,163,90,0.05)",
      "border_left": "4px solid #07a35a",
      "padding": "16px",
      "margin_top": "16px",
      "margin_bottom": "16px",
      "border_radius": "0 8px 8px 0"
    },
    "callout_title": {
      "font_weight": "600",
      "color": "#07a35a",
      "margin_bottom": "8px",
      "font_size": "15px"
    },
    "callout_content": {
      "font_size": "14px",
      "color": "#333333",
      "line_height": "1.7",
      "letter_spacing": "0.3px"
    },
    "h4": {
      "font_size": "17px",
      "font_weight": "bold",
      "color": "#1d1d1f",
      "border_left": "2px solid #07a35a",
      "padding": "0 0 0 8px",
      "margin_top": "24px",
      "margin_bottom": "8px",
      "line_height": "1.3"
    },
    "h5": {
      "font_size": "16px",
      "font_weight": "bold",
      "color": "#555555",
      "padding": "0",
      "margin_top": "20px",
      "margin_bottom": "6px",
      "line_height": "1.3"
    },
    "h6": {
      "font_size": "15px",
      "font_weight": "bold",
      "color": "#888888",
      "padding": "0",
      "margin_top": "16px",
      "margin_bottom": "6px",
      "line_height": "1.3"
    }
  },
  "dark_mode": {
    "wrapper": {
      "bgcolor": "#0f0f1a"
    },
    "h1": {
      "color": "#5cf69b"
    },
    "h2": {
      "color": "#5cf69b"
    },
    "h3": {
      "color": "#e5e5e7",
      "bgcolor": "rgba(92,246,155,0.08)"
    },
    "h4": {
      "color": "#c8c8c8"
    },
    "strong": {
      "color": "#e0a060"
    },
    "code_block": {
      "bgcolor": "#1a1a2e"
    },
    "code_header": {
      "bgcolor": "#1a1a2e"
    },
    "pre": {
      "bgcolor": "#1a1a2e",
      "color": "#e5e5e7"
    },
    "pre_code": {
      "color": "#e5e5e7"
    },
    "code": {
      "bgcolor": "rgba(92,246,155,0.15)",
      "color": "#5cf69b"
    },
    "blockquote": {
      "bgcolor": "rgba(92,246,155,0.06)"
    },
    "img_wrapper": {
      "bgcolor": "#1a1a2e"
    },
    "th": {
      "bgcolor": "#1a1a2e"
    },
    "callout": {
      "bgcolor": "rgba(92,246,155,0.08)"
    },
    "ol_item_bullet": {
      "bgcolor": "rgba(92,246,155,0.2)"
    }
  }
}
